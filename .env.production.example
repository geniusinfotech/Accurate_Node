# ---------------------------------------------------------------------------
# Accurate Liquid API — PRODUCTION
#
# Copy to .env ON THE SERVER and fill in the blanks. Secret values are
# deliberately empty here so this file is safe to keep in the repo.
#
#   scp .env.production.example ubuntu@<server>:/path/to/Accurate_Node/.env
#
# Topology: frontend on www.example.com (+ example.com), API on api.example.com.
# All are subdomains of example.com, which is what makes the shared
# COOKIE_DOMAIN below work.
#
# Every key here is validated by the Joi schema in src/app.module.ts —
# the app refuses to boot on a bad value rather than failing at runtime.
# ---------------------------------------------------------------------------

NODE_ENV=production
PORT=9009

# ---------------- Database ----------------
MONGODB_URI=

# ---------------- Redis ----------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
CACHE_TTL=300

# ---------------- JWT ----------------
# Both secrets must be >= 32 chars. Generate fresh values for production —
# never reuse the dev secrets:
#   ./scripts/generate-secrets.sh
JWT_SECRET=
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# ---------------- Auth cookies ----------------
# The frontend (www.example.com) and the API (api.example.com) are different
# hostnames, so the session cookie is cross-site:
#
#   COOKIE_CROSS_SITE=true  -> sameSite=none, and forces secure=true
#   COOKIE_DOMAIN           -> scopes the cookie to the shared parent domain
#                              so a cookie set by api.example.com is sent to
#                              www.example.com. Without it the cookie stays
#                              host-only on the API and the Next.js proxy in
#                              the Next.js frontend never sees it — login
#                              appears to succeed, then every navigation to
#                              /admin bounces back to /auth/login.
#
# Both hosts must be HTTPS; browsers reject SameSite=None without Secure.
COOKIE_CROSS_SITE=true
COOKIE_DOMAIN=.example.com

# COOKIE_SECURE=false is for plain-HTTP local testing only and is ignored
# when COOKIE_CROSS_SITE=true. Never set it in production.

# ---------------- URLs ----------------
# Scheme included, no trailing slash. ALLOWED_ORIGINS is matched exactly
# against the browser's Origin header (CORS runs with credentials:true), so
# list every host the site is reachable on — apex included, since it is
# served directly rather than redirected to www.
FRONTEND_URL=https://www.example.com
ALLOWED_ORIGINS=https://www.example.com,https://example.com

# ---------------- Email ----------------
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=

# ---------------- Google OAuth ----------------
# The callback lives on the API host (note the /api prefix), not the frontend. This exact URL must
# also be registered under "Authorised redirect URIs" in the Google Cloud
# console, or sign-in fails with redirect_uri_mismatch.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://api.example.com/api/auth/google/callback

# ---------------- Razorpay ----------------
# Live keys, not rzp_test_*. REQUIRED in production: the app refuses to boot without them.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------------- Rate limiting ----------------
# milliseconds
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
AUTH_THROTTLE_LIMIT=5

LOG_LEVEL=warn

# ---------------- Cash on delivery ----------------
# Leave unset. The API refuses any order without a valid Razorpay payment unless this is "true".
# COD_ENABLED=true
