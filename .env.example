# Application Configuration
PORT=9004
NODE_ENV=development

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/glitera

# Redis (cache layer to reduce database load)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
CACHE_TTL=300

# JWT - CRITICAL: Use strong secrets in production (at least 32 characters)
# Generate using: openssl rand -base64 64
# Example strong secret (DO NOT USE THIS - GENERATE YOUR OWN):
# JWT_SECRET=<run: node -e "console.log(require('crypto').randomBytes(64).toString('base64'))">
JWT_SECRET=your-secret-key-here-change-in-production-min-32-chars
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=your-refresh-secret-key-here-different-from-jwt-secret-min-32-chars
JWT_REFRESH_EXPIRES_IN=7d

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# Google OAuth
GOOGLE_CLIENT_ID=<your-google-client-id>
GOOGLE_CLIENT_SECRET=<your-google-client-secret>
GOOGLE_CALLBACK_URL=http://localhost:9004/auth/google/callback

# Frontend URL
FRONTEND_URL=http://localhost:9008

# CORS Allowed Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:9008,https://glitera.com


# Logging
LOG_LEVEL=debug

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_RATE_LIMIT=10

# Production Security Recommendations:
# 1. Set NODE_ENV=production
# 2. Use strong JWT secrets (64+ characters, generated randomly)
# 3. Enable MongoDB SSL/TLS
# 4. Use environment variables encryption
# 5. Never commit this file to version control
# 6. Set LOG_LEVEL=error in production

# ---------------- Auth cookies ----------------
# Same-origin deployment (frontend + API behind one nginx host): leave all three unset.
#   -> sameSite=lax, secure=true, host-only cookie.
#
# Cross-site deployment (e.g. app.glitera.in + api.glitera.in): both required.
#   COOKIE_CROSS_SITE=true forces sameSite=none + secure=true (browser requirement).
#   COOKIE_DOMAIN must be the shared parent domain, with the leading dot.
# COOKIE_CROSS_SITE=true
# COOKIE_DOMAIN=.glitera.in
#
# Local/plain-HTTP testing only (bare IP, no TLS). Never set this in production —
# without it browsers silently discard the auth cookie over http://.
# COOKIE_SECURE=false
